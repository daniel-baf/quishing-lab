# Long, random token for the /admin dashboard. Required.
ADMIN_TOKEN=replace-with-a-long-random-token

# Host port for the panel (defaults to 3000).
PORT=3000

# LAN IP used to build the QR arsenal URLs.
# With `make up` it is autodetected on the host; export it to force:
#   LAN_IP=192.168.x.x make up
# With `npm start` it is read from this file.
# LAN_IP=192.168.x.x

# Postgres password for the `db` service (docker-compose). Required for the
# compose/VPS deployment — pick a random one:
POSTGRES_PASSWORD=replace-with-a-random-password

# Postgres connection for loot persistence. With docker-compose, the `db`
# service provides it — uncomment for the compose/VPS deployment, using the
# same password as above:
# DATABASE_URL=postgres://quishing:replace-with-a-random-password@db:5432/quishing
# Without it the app keeps the loot in memory only (local dev default).
