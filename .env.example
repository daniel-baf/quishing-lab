# Token largo y aleatorio para el panel /admin. Obligatorio.
ADMIN_TOKEN=reemplaza-por-un-token-largo-y-aleatorio

# Puerto del host para la landing (por defecto 3000).
PORT=3000

# Desactiva el formulario de login falso (por defecto está activo).
# ENABLE_FAKE_LOGIN=false

# URL pública del túnel Cloudflare (opcional; la muestra /api/config).
# PUBLIC_URL=

# IP de la red local para las URLs del arsenal QR.
# Con `make up` se autodetecta en el host; expórtala para forzarla:
#   LAN_IP=192.168.x.x make up
# Con `npm start` se lee de este archivo.
# LAN_IP=192.168.x.x
