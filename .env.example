# Puerto local del servidor
PORT=3000

# Token fijo del panel /admin. Usa un valor largo y único; no lo subas a Git.
ADMIN_TOKEN=reemplaza-por-un-token-largo-y-aleatorio

# URL pública del túnel de Cloudflare (solo para pre-llenar el generador de QR del panel)
# PUBLIC_URL=https://algo.trycloudflare.com

# false = omitir el login falso y saltar directo a la escena de cámara
ENABLE_FAKE_LOGIN=true
